#!/bin/sh /etc/rc.common
# procd init script for edge_collector.py
# Install to /etc/init.d/edge-collector, then:
#   chmod +x /etc/init.d/edge-collector
#   /etc/init.d/edge-collector enable
#   /etc/init.d/edge-collector start

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
SCRIPT=/opt/edge-collector/edge_collector.py
PIDFILE=/var/run/edge-collector.pid

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" "$SCRIPT"
    procd_set_param env EDGE_CONFIG=/etc/edge-collector/config.json
    procd_set_param env LOG_LEVEL=INFO

    # respawn: auto-restart on crash. Params: threshold(s) retry-count backoff(s)
    # -- if it crashes more than 5 times within 60s, procd stops retrying
    # to avoid hammering a genuinely broken config; otherwise it just
    # restarts after a 5s delay every time.
    procd_set_param respawn 3600 5 5

    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"

    # ties the service to the hardware watchdog if the platform exposes
    # /dev/watchdog -- procd pets it as long as this instance is alive
    procd_set_param watchdog

    procd_close_instance
}

stop_service() {
    :
}

service_triggers() {
    procd_add_reload_trigger "edge-collector"
}
